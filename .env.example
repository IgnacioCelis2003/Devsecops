VERIFY_SSL=True
WAZUH_CA_BUNDLE=
DOMAINS_ALLOWLIST=localhost,127.0.0.1
CORS_ALLOW_ORIGINS=http://localhost,http://127.0.0.1,https://localhost,https://127.0.0.1
SEED_EXAMPLE_DATA=false
